# Copy to .env and fill in. Every value here is declared on Settings in app/config.py.

# --- Database ---------------------------------------------------------------
# Schema is managed by Alembic: run `alembic upgrade head` after setting this.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymbro
# SQLite alternative for local development:
# DATABASE_URL=sqlite:///./gymbro.db

# --- Auth -------------------------------------------------------------------
JWT_SECRET_KEY=your-secure-random-secret-key-here

# Google OAuth 2.0 — see docs/GOOGLE_OAUTH_SETUP.md
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The OAuth callback is derived from FRONTEND_URL as <FRONTEND_URL>/auth/callback.
# Register that exact URL in the Google console.
FRONTEND_URL=http://localhost:5173

# --- AI meal photo logging --------------------------------------------------
# Both are optional. Without them the services run in mock mode and return
# fixed sample data instead of calling out.

# Google Cloud Vision — food detection
# Get a key: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=

# USDA FoodData Central — nutrition lookup
# Get a key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# --- CORS -------------------------------------------------------------------
# Comma-separated production origins. Localhost dev origins are always allowed.
# CORS_ALLOWED_ORIGINS=https://gym-bro-chi.vercel.app
# Optional extra origins by regex. Unset by default - on Vercel the frontend and
# API share an origin, so CORS is not consulted. If you do set it, include the
# team slug: a bare "gym-bro-*" pattern matches anyone else's deployment too.
# CORS_PREVIEW_ORIGIN_REGEX=

# --- Misc -------------------------------------------------------------------
# "development" or "test" enables the X-User-Id dev auth header.
ENVIRONMENT=development
