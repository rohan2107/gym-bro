# Copy to .env and adjust as needed

# Database Configuration
# For local Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymbro

# For SQLite (development default in code)
# DATABASE_URL=sqlite:///./gymbro.db

# JWT Authentication
JWT_SECRET_KEY=your-secure-random-secret-key-here

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Phase 4: AI Meal Photo Logging APIs
# Google Cloud Vision API - Food Detection
# Get key: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# USDA FoodData Central API - Nutrition Lookup
# Get key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your-usda-api-key

# Vercel Blob Storage - Photo Storage
# Auto-generated in Vercel project settings
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token
