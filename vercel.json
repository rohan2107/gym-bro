{
  "version": 2,
  "builds": [
    {
      "src": "gymbro-web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "cd gymbro-web && npm run build",
        "outputDirectory": "gymbro-web/dist"
      }
    },
    {
      "src": "api/handler.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/handler" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
