{
  "buildCommand": "cd gymbro-web && npm ci && npm run build",
  "outputDirectory": "gymbro-web/dist",
  "functions": {
    "gymbro-api/api/handler.py": {
      "runtime": "@vercel/python@4.3.1"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/gymbro-api/api/handler.py"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
