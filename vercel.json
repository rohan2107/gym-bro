{
  "version": 2,
  "builds": [
    {
      "src": "gymbro-web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "gymbro-api/api/handler.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/gymbro-api/api/handler.py"
    },
    {
      "src": "/(.*)",
      "dest": "/gymbro-web/dist/$1"
    }
  ]
}
