{
  "version": 2,
  "builds": [
    {
      "src": "gymbro-api/api/handler.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "gymbro-api/api/handler.py"
    },
    {
      "src": "/(.*)",
      "dest": "gymbro-web/$1"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url"
  }
}
